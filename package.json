{
  "name": "nodus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24",
    "yarn": "4.18.1",
    "npm": "please-use-yarn",
    "pnpm": "please-use-yarn"
  },
  "scripts": {
    "preinstall": "node -e \"if(!/^yarn\\//.test(process.env.npm_config_user_agent||'')){console.error('This repository uses Yarn 4 (see packageManager in package.json). Run: yarn install');process.exit(1)}\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "yarn workspaces foreach -A --topological run typecheck",
    "test": "yarn workspaces foreach -A run test",
    "build": "yarn workspaces foreach -A --topological run build",
    "dev:desktop": "bash scripts/run-desktop.sh --demo",
    "dev:cloud:k3d": "bash scripts/run-cloud-k3d.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "resolutions": {
    "nanoid@npm:3.3.3": "npm:^3.3.18",
    "nanoid@npm:4.0.2": "npm:^5.1.16",
    "lodash-es@npm:4.17.21": "npm:^4.18.1",
    "katex@npm:^0.16.0": "npm:^0.19.0"
  },
  "workspaces": [
    "apps/desktop/frontend",
    "web",
    "packages/*",
    "shared/conformance/ts"
  ]
}
