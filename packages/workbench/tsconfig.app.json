        "../../node_modules/@excalidraw/excalidraw/types/excalidraw/types.d.ts"
      ],
      "@excalidraw/excalidraw/*": ["../../node_modules/@excalidraw/excalidraw/types/excalidraw/*"],
      "@excalidraw/common": [
        "../../node_modules/@excalidraw/excalidraw/types/common/src/index.d.ts"
      ],
      "@excalidraw/common/*": ["../../node_modules/@excalidraw/excalidraw/types/common/src/*"],
      "@excalidraw/element": [
        "../../node_modules/@excalidraw/excalidraw/types/element/src/index.d.ts"
      ],
      "@excalidraw/element/*": ["../../node_modules/@excalidraw/excalidraw/types/element/src/*"],
      "@excalidraw/math": ["../../node_modules/@excalidraw/excalidraw/types/math/src/index.d.ts"],
