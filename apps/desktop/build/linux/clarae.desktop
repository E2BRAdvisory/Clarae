[Desktop Entry]
Type=Application
Name=Clarae notanda
GenericName=Notes and knowledge base
Comment=Your knowledge, carefully preserved in its clarity.
Exec=clarae %U
Icon=clarae
Terminal=false
Categories=Office;Utility;TextEditor;
Keywords=notes;markdown;knowledge;vault;
StartupWMClass=clarae
# clarae:// links (open a note, OIDC login callback): the second instance receives the URL in argv
# and forwards it to the running one (ADR-0001). memobrain:// is the scheme of 1.x: the links already
# written in notes and the redirect URIs registered in existing realms keep working (dropped in 2.0).
MimeType=x-scheme-handler/clarae;x-scheme-handler/memobrain;
