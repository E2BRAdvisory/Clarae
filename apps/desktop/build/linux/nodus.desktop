[Desktop Entry]
Type=Application
Name=Nodus
GenericName=Notes and knowledge base
Comment=Local-first notes and knowledge base
Exec=nodus %U
Icon=nodus
Terminal=false
Categories=Office;Utility;TextEditor;
Keywords=notes;markdown;knowledge;vault;
StartupWMClass=nodus
# nodus:// links (open a note, OIDC login callback): the second instance receives the URL in argv
# and forwards it to the running one (ADR-0001).
MimeType=x-scheme-handler/nodus;
