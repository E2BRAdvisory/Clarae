[Desktop Entry]
Type=Application
Name=MemoBrain Notes
GenericName=Notes and knowledge base
Comment=Local-first notes and knowledge base
Exec=memobrain %U
Icon=memobrain
Terminal=false
Categories=Office;Utility;TextEditor;
Keywords=notes;markdown;knowledge;vault;
StartupWMClass=memobrain
# memobrain:// links (open a note, OIDC login callback): the second instance receives the URL in argv
# and forwards it to the running one (ADR-0001).
MimeType=x-scheme-handler/memobrain;
