{
  "name": "@clarae/desktop-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/esbuild.mjs dev",
    "build": "tsc -b && node scripts/esbuild.mjs build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:prod": "E2E_PREVIEW=1 playwright test e2e/drawing.spec.ts e2e/drawing-tools.spec.ts e2e/drawing-wp5.spec.ts e2e/drawing-wp6.spec.ts e2e/drawing-embed.spec.ts e2e/graph.spec.ts e2e/canvas.spec.ts"
  },
  "dependencies": {
    "@clarae/workbench": "workspace:*",
    "@wailsio/runtime": "3.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
