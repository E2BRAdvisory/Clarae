{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "nodus",
  "outputfilename": "nodus",
  "frontend:install": "yarn install",
  "frontend:build": "yarn run build",
  "frontend:dev:watcher": "yarn run dev",
  "frontend:dev:serverUrl": "auto",
  "wailsjsdir": "./frontend",
  "info": {
    "companyName": "Nodus",
    "productName": "Nodus",
    "productIdentifier": "dev.nodus.desktop",
    "copyright": "Copyright © 2026",
    "comments": "Local-first notes and knowledge base",
    "protocols": [
      {
        "scheme": "nodus",
        "description": "Nodus URL scheme (open notes, OIDC callback)",
        "role": "Editor"
      }
    ]
  },
  "author": {
    "name": "Efrem Ropelato",
    "email": "efrem.ropelato@e2br-advisory.ch"
  }
}
