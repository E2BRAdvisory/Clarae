# Environment for `task dev-cloud` against deploy/docker/compose.dev.yaml. Development values only.
# 18081/18082: 8081/8082 are commonly taken by other local services.
LISTEN_ADDR=127.0.0.1:18081
GRPC_LISTEN_ADDR=127.0.0.1:18082
# Internal listener of --role=worker only (/metrics, /healthz, /readyz).
METRICS_LISTEN_ADDR=127.0.0.1:18083
DATABASE_URL=postgres://clarae:clarae@127.0.0.1:5433/clarae?sslmode=disable
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=clarae
S3_SECRET_KEY=clarae-secret
S3_BUCKET_BLOBS=clarae-blobs
S3_BUCKET_EXPORTS=clarae-exports
S3_USE_PATH_STYLE=true
OIDC_ISSUER=http://localhost:8080/realms/clarae
OIDC_AUDIENCE=clarae-api
KC_ADMIN_BASE_URL=http://localhost:8080
KC_ADMIN_CLIENT_ID=clarae-admin-svc
KC_ADMIN_CLIENT_SECRET=dev-admin-svc-secret
WEB_UI_ORIGIN=http://localhost:5174
LOG_LEVEL=debug
