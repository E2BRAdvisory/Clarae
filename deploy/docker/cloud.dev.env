# Environment for `make dev-cloud` against deploy/docker/compose.dev.yaml. Development values only.
# 18081/18082: 8081/8082 are commonly taken by other local services.
LISTEN_ADDR=127.0.0.1:18081
GRPC_LISTEN_ADDR=127.0.0.1:18082
DATABASE_URL=postgres://nodus:nodus@127.0.0.1:5433/nodus?sslmode=disable
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=nodus
S3_SECRET_KEY=nodus-secret
S3_BUCKET_BLOBS=nodus-blobs
S3_BUCKET_EXPORTS=nodus-exports
S3_USE_PATH_STYLE=true
OIDC_ISSUER=http://localhost:8080/realms/nodus
OIDC_AUDIENCE=nodus-api
KC_ADMIN_BASE_URL=http://localhost:8080
KC_ADMIN_CLIENT_ID=nodus-admin-svc
KC_ADMIN_CLIENT_SECRET=dev-admin-svc-secret
WEB_UI_ORIGIN=http://localhost:5174
LOG_LEVEL=debug
