{
  "realm": "nodus",
  "displayName": "Nodus",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 10,
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(3)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "webAuthnPolicyRpEntityName": "Nodus",
  "webAuthnPolicyPasswordlessRpEntityName": "Nodus",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "it"],
  "defaultLocale": "en",
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "nodus-admin",
        "description": "Nodus administrator: users, groups, quotas, config profiles, audit. No access to vault content."
      },
      {
        "name": "nodus-user",
        "description": "Nodus user: own vaults, shares, ZIP download."
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-nodus",
    "composite": true,
    "composites": {
      "realm": ["nodus-user", "offline_access"]
    }
  },
  "clientScopes": [
    {
      "name": "basic",
      "description": "Adds the sub claim",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "User profile claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "firstName",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "claim.name": "given_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "lastName",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName",
            "claim.name": "family_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "Email claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "emailVerified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "Realm roles (realm_access.roles)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "nodus-api-audience",
      "description": "Adds aud=nodus-api to access tokens issued to Nodus clients",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "nodus-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "nodus-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "nodus-desktop",
      "name": "Nodus Desktop",
      "description": "Wails desktop client: Authorization Code + PKCE via system browser (D-08: loopback primary, custom scheme fallback)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://127.0.0.1/*", "http://localhost/*", "nodus://auth/callback"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "nodus://auth/logout##http://127.0.0.1/*",
        "use.refresh.tokens": "true"
      },
      "defaultClientScopes": ["basic", "openid", "profile", "email", "roles", "nodus-api-audience"],
      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "nodus-web",
      "name": "Nodus Web UI",
      "description": "Cloud Web UI SPA (admin console and user area): Authorization Code + PKCE",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5174/*", "http://localhost:18081/*"],
      "webOrigins": ["http://localhost:5174", "http://localhost:18081"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5174/*##http://localhost:18081/*"
      },
      "defaultClientScopes": ["basic", "openid", "profile", "email", "roles", "nodus-api-audience"],
      "optionalClientScopes": []
    },
    {
      "clientId": "nodus-api",
      "name": "Nodus Cloud API",
      "description": "Resource server: validates bearer tokens with aud=nodus-api. Never issues tokens.",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "nodus-admin-svc",
      "name": "Nodus Cloud admin service account",
      "description": "Confidential client used by the cloud Admin Module to call the Keycloak Admin REST API",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-admin-svc-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "roles"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "service-account-nodus-admin-svc",
      "enabled": true,
      "serviceAccountClientId": "nodus-admin-svc",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users"]
      }
    },
    {
      "username": "admin",
      "email": "admin@nodus.local",
      "firstName": "Ada",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "nodus-dev-password",
          "temporary": false
        }
      ],
      "realmRoles": ["nodus-admin", "nodus-user", "offline_access"]
    },
    {
      "username": "user1",
      "email": "user1@nodus.local",
      "firstName": "Uno",
      "lastName": "Utente",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "nodus-dev-password",
          "temporary": false
        }
      ],
      "realmRoles": ["nodus-user", "offline_access"]
    },
    {
      "username": "user2",
      "email": "user2@nodus.local",
      "firstName": "Due",
      "lastName": "Utente",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "nodus-dev-password",
          "temporary": false
        }
      ],
      "realmRoles": ["nodus-user", "offline_access"]
    }
  ]
}
