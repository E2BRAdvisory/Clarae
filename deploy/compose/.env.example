# Copy to .env and edit. Generate every secret with:  openssl rand -base64 24 | tr -d '=+/'
# Never commit the real .env.

COMPOSE_PROJECT_NAME=nodus-onprem

# --- Public names (DNS must resolve them to this host) -----------------------------------------
NODUS_HOST=nodus.example.com          # Web UI + REST API
NOTIFY_HOST=notify.example.com        # gRPC notification stream (TLS + HTTP/2)
AUTH_HOST=auth.example.com            # Keycloak
PUBLIC_SCHEME=https                   # https in production
HTTP_PORT=80
HTTPS_PORT=443
# CADDY_GLOBAL=local_certs            # internal CA instead of Let's Encrypt (clients must trust it)

# --- Image ---------------------------------------------------------------------------------------
NODUS_IMAGE=ghcr.io/ORG/nodus-cloud
NODUS_VERSION=1.0.0                   # a released tag; verify the signature first (docs/release/README.md)

# --- Secrets (replace all) ---------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
# Client secret of "nodus-admin-svc" in the Keycloak realm: after the first start set a new secret
# in the Keycloak console (Clients > nodus-admin-svc > Credentials) and put the same value here.
KC_ADMIN_CLIENT_SECRET=change-me

LOG_LEVEL=info
