# Reverse proxy of the on-premise stack.
# MEMOBRAIN_SITE / NOTIFY_SITE / AUTH_SITE are the site addresses (default: the host names, which makes
# Caddy obtain public certificates automatically: ports 80/443 must be reachable and the DNS names
# must point here). For an internal CA set CADDY_GLOBAL="local_certs" (clients must then trust that CA);
# for a local test over plain HTTP use site addresses with the http:// prefix.
{
	{$CADDY_GLOBAL}
}

# HSTS (spec §3.7) on the HTTPS sites: after the first visit browsers never try plain HTTP again, so a
# link or a typed host name cannot be downgraded. Only over HTTPS (a plain http:// test site sends
# nothing), and only when the backend did not set its own (Keycloak does). No includeSubDomains: the
# three hosts may share a parent domain with other sites that are not served over HTTPS.
(hsts) {
	@https protocol https
	header @https ?Strict-Transport-Security "max-age=31536000"
}

{$MEMOBRAIN_SITE} {
	import hsts
	request_body {
		max_size 64MB
	}
	reverse_proxy cloud-api:18081 {
		health_uri /api/v1/readyz
		health_interval 10s
		# Streaming responses (SSE) must not be buffered.
		flush_interval -1
	}
}

# gRPC (notification stream) needs HTTP/2 to the backend: "h2c://" is HTTP/2 without TLS inside the
# private network. Clients reach this host over TLS (HTTP/2 via ALPN), which is mandatory for gRPC.
{$NOTIFY_SITE} {
	import hsts
	reverse_proxy h2c://cloud-api:18082 {
		flush_interval -1
		transport http {
			versions h2c
			read_timeout 1h
		}
	}
}

# Keycloak. The clients need only the realm "memobrain" (/realms/memobrain/...: OIDC endpoints, login and
# account pages) and the theme assets (/resources/...). The administration console and its REST API (/admin)
# and the realm "master" (where the server administrator logs in) answer 403 unless the client address is in
# KEYCLOAK_ADMIN_FROM (space separated CIDRs; the default 127.0.0.1/32 matches no external client). The cloud
# service calls the Admin REST API directly on keycloak:8080, not through this site.
{$AUTH_SITE} {
	import hsts
	@kc_admin {
		# ";*": Keycloak (JAX-RS) ignores matrix parameters, so /admin;x/ is the console too.
		path /admin /admin/* /admin;* /realms/master /realms/master/* /realms/master;*
		not remote_ip {$KEYCLOAK_ADMIN_FROM:127.0.0.1/32}
	}
	respond @kc_admin 403
	reverse_proxy keycloak:8080
}
