{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemoBrain Notes Cloud chart values",
  "type": "object",
  "definitions": {
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    },
    "autoscaling": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] }
      }
    },
    "topologySpread": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxSkew": { "type": "integer", "minimum": 1 },
        "topologyKey": { "type": "string" },
        "whenUnsatisfiable": { "enum": ["ScheduleAnyway", "DoNotSchedule"] }
      }
    },
    "role": {
      "type": "object",
      "required": ["replicas", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/definitions/resources" },
        "autoscaling": { "$ref": "#/definitions/autoscaling" },
        "pdb": { "$ref": "#/definitions/pdb" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
        "preStopSleepSeconds": { "type": "integer", "minimum": 0 },
        "progressDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "topologySpread": { "$ref": "#/definitions/topologySpread" },
        "antiAffinity": { "enum": ["soft", "hard", "none"] },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "tmp": {
          "type": "object",
          "properties": { "sizeLimit": { "type": ["string", "null"] } }
        },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "probes": {
          "type": "object",
          "properties": { "liveness": { "type": "object" }, "readiness": { "type": "object" } }
        }
      }
    }
  },
  "required": ["image", "api", "worker", "config", "service"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "api": {
      "allOf": [
        { "$ref": "#/definitions/role" },
        {
          "properties": {
            "probes": {
              "type": "object",
              "properties": {
                "startup": { "type": "object" },
                "liveness": { "type": "object" },
                "readiness": { "type": "object" }
              }
            }
          }
        }
      ]
    },
    "worker": { "$ref": "#/definitions/role" },
    "config": {
      "type": "object",
      "required": ["OIDC_ISSUER", "S3_ENDPOINT"],
      "properties": {
        "OIDC_ISSUER": { "type": "string", "minLength": 1 },
        "S3_ENDPOINT": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": { "type": "string" }
    },
    "secret": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "values": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "externalSecret": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "apiVersion": { "type": "string" },
        "refreshInterval": { "type": "string" },
        "secretStoreRef": {
          "type": "object",
          "properties": { "name": { "type": "string" }, "kind": { "type": "string" } }
        },
        "data": { "type": "array" }
      }
    },
    "service": {
      "type": "object",
      "required": ["httpPort", "grpcPort"],
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "grpcPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "tls": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" }, "secretName": { "type": "string" } }
        },
        "annotations": { "type": "object" },
        "proxyBodySize": { "type": "string" },
        "grpc": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["host", "path"] },
            "host": { "type": "string" },
            "path": { "type": "string", "pattern": "^/" },
            "streamTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "annotations": { "type": "object" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array" },
        "restrictEgress": { "type": "boolean" },
        "egressTo": { "type": "array" },
        "metricsFrom": { "type": "array" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "metrics": {
      "type": "object",
      "properties": { "podAnnotations": { "type": "boolean" } }
    }
  }
}
