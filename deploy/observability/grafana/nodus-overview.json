          "expr": "rate(nodus_db_pool_acquire_wait_seconds_total[$__rate_interval])",
          "legendFormat": "attesa",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(nodus_db_pool_empty_acquires_total[$__rate_interval])",
