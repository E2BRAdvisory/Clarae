    {
      "id": 26,
      "type": "timeseries",
      "title": "Saturazione del pool (%)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 49,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * max(nodus_db_pool_connections{state=\"acquired\"}) / max(nodus_db_pool_connections{state=\"max\"})",
          "legendFormat": "acquisite / max",
          "refId": "A"
        }
