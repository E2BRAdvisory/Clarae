          "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (rate(nodus_http_request_duration_seconds_bucket[$__rate_interval]))))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
