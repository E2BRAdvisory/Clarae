{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "e2e",
    "e2e-security",
    "e2e-cloud",
    "e2e-mixed",
    "playwright.config.ts",
    "playwright.security.config.ts",
    "playwright.workbench-ui.config.ts",
    "playwright.cloud.config.ts",
    "playwright.mixed.config.ts"
  ]
}
