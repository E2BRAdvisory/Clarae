{
  "name": "@memobrain/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/esbuild.mjs dev",
    "build": "tsc -b && node scripts/esbuild.mjs build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:security": "playwright test -c playwright.security.config.ts",
    "e2e:workbench-ui": "E2E_TARGET=web E2E_ORIGIN=http://localhost:5176 playwright test -c playwright.workbench-ui.config.ts",
    "e2e:cloud": "playwright test -c playwright.cloud.config.ts"
  },
  "dependencies": {
    "@memobrain/api-client": "workspace:*",
    "@memobrain/sqlite-bridge": "workspace:*",
    "@memobrain/ui": "workspace:*",
    "@memobrain/vaultcrypto-web": "workspace:*",
    "@memobrain/workbench": "workspace:*",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@tanstack/react-query": "^5.104.5",
    "i18next": "^26.5.2",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
